# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# AI Gateway API Key (required for non-Vercel deployments)
# For Vercel deployments, OIDC tokens are used automatically
AI_GATEWAY_API_KEY=****


# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# ---------- Le Studio ----------
# Only this email can create an account; guest access is turned off.
STUDIO_OWNER_EMAIL=****

# Claude: set an Anthropic API key, or leave empty to use the AI Gateway above.
ANTHROPIC_API_KEY=****
ANTHROPIC_MODEL=claude-sonnet-5

# Personal LinkedIn account (document pre-check), published through Typefully
TYPEFULLY_API_KEY=****
TYPEFULLY_SOCIAL_SET_ID=****

# Second LinkedIn account (candidate pre-selection), published through Buffer
BUFFER_ACCESS_TOKEN=****
BUFFER_LINKEDIN_CHANNEL_ID=****

# Imene's digital twin and cloned voice, for Tuesday videos
HEYGEN_API_KEY=****
HEYGEN_AVATAR_PORTRAIT_ID=****
HEYGEN_VOICE_ID=****

# Protects the daily autopilot (Vercel Cron sends it automatically)
CRON_SECRET=****
